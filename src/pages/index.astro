---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedPost from '@/components/FeaturedPost.astro';
import Icon from '@/components/Icon.astro';
import PostList from '@/components/PostList.astro';
import { SITE, SOCIAL } from '@/consts';
import { getFeaturedPost, getPosts } from '@/utils/posts';
import { url } from '@/utils/url';

const posts = await getPosts();
const featured = getFeaturedPost(posts);
const latest = posts.filter((p) => p !== featured).slice(0, 3);
---

<BaseLayout>
  <div class="container">
    <section class="hero">
      <img class="hero__avatar" src={url(SITE.avatar)} alt="Photo of Diego Mora" width="128" height="128" />
      <div class="hero__body">
        <p class="hero__addr">0x00401000 &lt;main&gt;:</p>
        <h1 class="hero__name">Diego Mora<span class="cursor" aria-hidden="true"></span></h1>
        <p class="hero__role">Reversing · game hacking · malware dev · Windows internals</p>
        <p class="hero__bio">
          Software Engineering student at UPC (Lima, Peru). I spend my time taking binaries apart to
          understand how they work from the inside —reversing, game hacking, malware development and
          Windows internals— and sharpening it all by playing CTFs. This is where I document what I
          learn.
        </p>
        <div class="hero__actions">
          <a class="btn btn-primary" href={url('/blog')}><Icon name="book" /> Blog</a>
          <a class="btn" href={SOCIAL.github} target="_blank" rel="me noopener"><Icon name="github" /> GitHub</a>
          <a class="btn" href={SOCIAL.linkedin} target="_blank" rel="me noopener"><Icon name="linkedin" /> LinkedIn</a>
          <a class="btn" href={SOCIAL.cylab} target="_blank" rel="me noopener"><Icon name="award" /> CyLab</a>
        </div>
      </div>
    </section>

    {
      featured && (
        <section class="home-section" aria-label="Featured post">
          <FeaturedPost post={featured} />
        </section>
      )
    }

    <section class="home-section">
      <h2 class="section-title">latest posts</h2>
      <PostList posts={latest} headingLevel="h3" />
      <a class="all-posts" href={url('/blog')}>view all posts <Icon name="arrow-right" size={14} /></a>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 36px;
    align-items: start;
    padding: 24px 0 56px;
  }

  .hero__avatar {
    width: 128px;
    height: 128px;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .hero__addr {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .hero__name {
    font-size: clamp(2rem, 6vw, 3rem);
    letter-spacing: -0.03em;
  }

  .cursor {
    display: inline-block;
    width: 0.5em;
    height: 0.9em;
    margin-left: 0.12em;
    vertical-align: -0.08em;
    background: var(--accent);
    opacity: 0.85;
    animation: blink 1.1s steps(1, end) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .hero__role {
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--accent);
  }

  .hero__bio {
    max-width: 62ch;
    margin: 18px 0 24px;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .home-section {
    margin-bottom: 48px;
  }

  .all-posts {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-top: 0;
    }

    .hero__avatar {
      width: 88px;
      height: 88px;
    }
  }
</style>
