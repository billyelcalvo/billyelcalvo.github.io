---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/utils/url';
---

<BaseLayout title="404" description="Page not found." noindex>
  <div class="container crash">
    <pre class="crash__dump" aria-hidden="true"><span class="sig">Program received signal SIGSEGV, Segmentation fault.</span>
0x0000000000000404 in ?? ()
(gdb) x/s $rip
0x404:  &lt;error: Cannot access memory at address 0x404&gt;</pre>
    <h1>Page not found</h1>
    <p>The address you're looking for isn't mapped. The post may have moved or never existed.</p>
    <a class="btn btn-primary" href={url('/')}>back to home</a>
  </div>
</BaseLayout>

<style>
  .crash {
    max-width: 760px;
  }

  .crash__dump {
    margin: 0 0 32px;
    padding: 18px 20px;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .sig {
    color: var(--cat-pwn);
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
  }

  p {
    margin: 12px 0 24px;
    color: var(--text-muted);
  }
</style>
