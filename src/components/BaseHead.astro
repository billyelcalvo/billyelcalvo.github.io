---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';
import { SITE } from '@/consts';
import { url } from '@/utils/url';

export interface SeoProps {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  type = 'website',
  publishedTime,
  tags = [],
  noindex = false,
} = Astro.props as SeoProps;

const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — reversing, pwn & CTFs`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image.startsWith('http') ? image : url(image), Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
<link rel="canonical" href={canonical} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="theme-color" content="#0e0e10" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{publishedTime && <meta property="article:author" content={SITE.author} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Theme: dark by default; applied before paint to avoid a flash. -->
<script is:inline>
  (() => {
    let theme = 'dark';
    try {
      theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
    } catch {}
    document.documentElement.dataset.theme = theme;
  })();
</script>
