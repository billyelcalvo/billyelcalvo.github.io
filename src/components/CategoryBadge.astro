---
import { CATEGORIES, type Category } from '@/consts';
import { url } from '@/utils/url';
import Icon from './Icon.astro';

interface Props {
  category: Category;
  link?: boolean;
}

const { category, link = true } = Astro.props;
const meta = CATEGORIES[category];
const Tag = link ? 'a' : 'span';
---

<Tag
  class="category-badge"
  href={link ? url(`/categories/${category}`) : undefined}
  style={`--cat: var(--cat-${category})`}
>
  <Icon name={meta.icon} size={13} />
  {meta.label.toLowerCase()}
</Tag>

<style>
  .category-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 9px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    line-height: 1;
    color: var(--cat);
    background: color-mix(in srgb, var(--cat) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat) 30%, transparent);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  a.category-badge:hover {
    text-decoration: none;
    border-color: var(--cat);
  }
</style>
