---
import type { Post } from '@/utils/posts';
import { readingTime } from '@/utils/posts';
import { url } from '@/utils/url';
import CategoryBadge from './CategoryBadge.astro';
import PostMeta from './PostMeta.astro';
import TagList from './TagList.astro';

interface Props {
  post: Post;
  activeTag?: string;
  headingLevel?: 'h2' | 'h3';
}

const { post, activeTag, headingLevel: Heading = 'h2' } = Astro.props;
const { title, description, date, category, tags, draft } = post.data;
const href = url(`/blog/${post.id}`);
---

<article class="post-card" style={`--cat: var(--cat-${category})`}>
  <div class="post-card__top">
    <PostMeta date={date} readingTime={readingTime(post)} draft={draft} />
    <CategoryBadge category={category} />
  </div>
  <Heading class="post-card__title">
    <a href={href}>{title}</a>
  </Heading>
  <p class="post-card__desc">{description}</p>
  <TagList tags={tags} active={activeTag} />
</article>

<style>
  .post-card {
    position: relative;
    padding: 20px 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }

  .post-card::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 18px;
    bottom: 18px;
    width: 2px;
    background: var(--cat);
    border-radius: 2px;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .post-card:hover {
    border-color: var(--border-strong);
  }

  .post-card:hover::before {
    opacity: 1;
  }

  /* Make the whole card clickable: the title link stretches over it. */
  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Keep the category badge and tags clickable above the overlay. */
  .post-card :global(a.category-badge),
  .post-card :global(a.tag) {
    position: relative;
    z-index: 2;
  }

  .post-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .post-card__title {
    font-size: 1.12rem;
    line-height: 1.4;
  }

  .post-card__title a {
    color: var(--text);
  }

  .post-card__title a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .post-card__desc {
    margin: 8px 0 14px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 520px) {
    .post-card {
      padding: 16px;
    }
  }
</style>
